"use client";

import { useId, useState } from "react";
import Image from "next/image";
import Link from "next/link";
import { useRouter } from "next/navigation";
import {
  AlertCircle,
  ArrowRight,
  Check,
  CheckCircle2,
  Eye,
  EyeOff,
  Lock,
  Mail,
  ShoppingBag,
  Store,
  Upload,
  User,
  X,
} from "lucide-react";

export default function SignUpPage() {
  const router = useRouter();
  const fileInputId = useId();

  // Form State
  const [formData, setFormData] = useState({
    name: "",
    email: "",
    password: "",
    role: "customer" as "customer" | "vendor",
  });

  const [profileImage, setProfileImage] = useState<File | null>(null);
  const [imagePreview, setImagePreview] = useState<string | null>(null);
  const [showPassword, setShowPassword] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [success, setSuccess] = useState<string | null>(null);
  const [isSubmitting, setIsSubmitting] = useState(false);

  // Password Validation Rules
  const passwordRules = {
    hasMinLength: formData.password.length >= 6,
    hasUppercase: /[A-Z]/.test(formData.password),
    hasLowercase: /[a-z]/.test(formData.password),
  };

  const isPasswordValid =
    passwordRules.hasMinLength &&
    passwordRules.hasUppercase &&
    passwordRules.hasLowercase;

  // Input change handler
  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const { name, value } = e.target;
    setFormData((prev) => ({ ...prev, [name]: value }));
    if (error) setError(null);
  };

  // Profile image handler
  const handleImageChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (file) {
      if (file.size > 5 * 1024 * 1024) {
        setError("Image size must be less than 5MB.");
        return;
      }
      setProfileImage(file);
      setImagePreview(URL.createObjectURL(file));
      if (error) setError(null);
    }
  };

  const handleRemoveImage = () => {
    setProfileImage(null);
    if (imagePreview) {
      URL.revokeObjectURL(imagePreview);
      setImagePreview(null);
    }
  };

  // Submit Handler
  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    setSuccess(null);

    // Validation
    if (!formData.name.trim()) {
      setError("Please enter your full name.");
      return;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(formData.email.trim())) {
      setError("Please enter a valid email address.");
      return;
    }

    if (!isPasswordValid) {
      setError("Password does not meet the security requirements.");
      return;
    }

    // Role Security: Ensure only valid public roles are accepted (no Admin creation)
    if (formData.role !== "customer" && formData.role !== "vendor") {
      setError("Invalid role selected. Public accounts can only be Customer or Vendor.");
      return;
    }

    setIsSubmitting(true);

    try {
      // Collects form data for future backend & Better Auth integration
      const collectedData = {
        name: formData.name.trim(),
        email: formData.email.trim(),
        password: formData.password,
        role: formData.role,
        imageFile: profileImage,
      };

      console.log("Collected Sign Up Data:", collectedData);

      // Success message & destination notice
      const destination =
        formData.role === "vendor" ? "Vendor Dashboard" : "Home";
      setSuccess(
        `Account created successfully as ${
          formData.role === "vendor" ? "Restaurant Owner" : "Customer"
        }! Redirecting to ${destination}...`
      );

      // Simulate redirect according to role
      setTimeout(() => {
        if (formData.role === "vendor") {
          router.push("/vendor/dashboard");
        } else {
          router.push("/");
        }
      }, 1500);
    } catch {
      setError("An unexpected error occurred during registration. Please try again.");
    } finally {
      setIsSubmitting(false);
    }
  };

  // Google Sign Up Handler
  const handleGoogleSignUp = () => {
    console.log("Google Sign Up initiated for role:", formData.role);
    setSuccess(`Connecting Google account as ${formData.role === "vendor" ? "Restaurant Owner" : "Customer"}...`);
    // Will be wired to Better Auth signIn.social({ provider: "google" }) later
  };

  return (
    <div className="relative min-h-screen bg-zinc-950 flex flex-col justify-center items-center px-4 py-12 sm:px-6 lg:px-8 overflow-hidden">
      {/* Background Ambient Glows */}
      <div className="pointer-events-none absolute inset-0" aria-hidden="true">
        <div className="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 size-96 rounded-full bg-orange-600/15 blur-3xl" />
        <div className="absolute bottom-1/4 right-1/4 size-80 rounded-full bg-red-600/10 blur-3xl" />
      </div>

      <div className="relative z-10 w-full max-w-lg">
        {/* Logo Lockup */}
        <div className="text-center mb-8">
          <Link
            href="/"
            className="inline-flex items-center gap-2 group transition-transform hover:scale-105"
          >
            <Image
              src="/assets/logo-icon.png"
              alt="PizzaHub Logo"
              width={40}
              height={40}
              priority
              className="h-10 w-auto"
            />
            <span className="flex flex-col text-left">
              <span className="text-2xl font-extrabold tracking-tight">
                <span className="text-white">Pizza</span>
                <span className="text-orange-500">Hub</span>
              </span>
              <svg
                viewBox="0 0 100 10"
                className="h-1.5 w-full"
                aria-hidden="true"
              >
                <path
                  d="M2 8 Q 55 -3 98 8"
                  fill="none"
                  stroke="#f59e0b"
                  strokeWidth="3"
                  strokeLinecap="round"
                />
              </svg>
            </span>
          </Link>
          <h2 className="mt-4 text-2xl font-bold tracking-tight text-white sm:text-3xl">
            Create an Account
          </h2>
          <p className="mt-1.5 text-sm text-zinc-400">
            Join PizzaHub as a customer or register your restaurant
          </p>
        </div>

        {/* Auth Card */}
        <div className="rounded-3xl border border-white/10 bg-zinc-900/85 p-6 sm:p-8 shadow-2xl backdrop-blur-xl">
          {/* Segmented Toggle: Sign In vs Sign Up */}
          <div className="grid grid-cols-2 rounded-2xl bg-zinc-950/80 p-1 border border-white/10 mb-6">
            <Link
              href="/sign-in"
              className="py-2.5 text-sm font-medium rounded-xl text-zinc-400 hover:text-white text-center transition-colors"
            >
              Sign In
            </Link>
            <button
              type="button"
              className="py-2.5 text-sm font-semibold rounded-xl bg-gradient-to-r from-red-600 to-orange-500 text-white shadow-md"
            >
              Sign Up
            </button>
          </div>

          {/* Feedback Messages */}
          {error && (
            <div className="mb-5 flex items-center gap-2.5 rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-400">
              <AlertCircle className="size-4 shrink-0 text-red-400" />
              <span>{error}</span>
            </div>
          )}

          {success && (
            <div className="mb-5 flex items-center gap-2.5 rounded-xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-400">
              <CheckCircle2 className="size-4 shrink-0 text-emerald-400" />
              <span>{success}</span>
            </div>
          )}

          {/* Google Sign Up Button */}
          <button
            type="button"
            onClick={handleGoogleSignUp}
            className="flex w-full items-center justify-center gap-3 rounded-xl border border-white/15 bg-zinc-950/60 px-4 py-3 text-sm font-semibold text-white transition-all hover:bg-zinc-800/80 hover:border-white/25"
          >
            <svg className="size-5" viewBox="0 0 24 24">
              <path
                fill="#4285F4"
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              />
              <path
                fill="#34A853"
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              />
              <path
                fill="#FBBC05"
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
              />
              <path
                fill="#EA4335"
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
              />
            </svg>
            Sign up with Google
          </button>

          {/* Divider */}
          <div className="relative my-6">
            <div className="absolute inset-0 flex items-center">
              <span className="w-full border-t border-white/10" />
            </div>
            <div className="relative flex justify-center text-xs uppercase">
              <span className="bg-zinc-900 px-3 text-zinc-500">
                or register with email
              </span>
            </div>
          </div>

          {/* Form */}
          <form onSubmit={handleSubmit} className="space-y-4">
            {/* Account Role Selection */}
            <div>
              <label className="block text-xs font-semibold uppercase tracking-wider text-zinc-300 mb-2">
                Select Account Role
              </label>
              <div className="grid grid-cols-2 gap-3">
                {/* Customer Card */}
                <button
                  type="button"
                  onClick={() =>
                    setFormData((prev) => ({ ...prev, role: "customer" }))
                  }
                  className={`flex flex-col items-start gap-1 rounded-2xl border p-3.5 text-left transition-all ${
                    formData.role === "customer"
                      ? "border-orange-500 bg-orange-500/10 text-white shadow-md shadow-orange-950/30"
                      : "border-white/10 bg-zinc-950/60 text-zinc-400 hover:border-white/20 hover:text-white"
                  }`}
                >
                  <div className="flex w-full items-center justify-between">
                    <ShoppingBag
                      className={`size-5 ${
                        formData.role === "customer"
                          ? "text-orange-500"
                          : "text-zinc-500"
                      }`}
                    />
                    {formData.role === "customer" && (
                      <span className="size-2 rounded-full bg-orange-500" />
                    )}
                  </div>
                  <span className="font-semibold text-sm mt-1">Customer</span>
                  <span className="text-[11px] text-zinc-400 leading-tight">
                    Order delicious pizza to your door
                  </span>
                </button>

                {/* Vendor Card */}
                <button
                  type="button"
                  onClick={() =>
                    setFormData((prev) => ({ ...prev, role: "vendor" }))
                  }
                  className={`flex flex-col items-start gap-1 rounded-2xl border p-3.5 text-left transition-all ${
                    formData.role === "vendor"
                      ? "border-orange-500 bg-orange-500/10 text-white shadow-md shadow-orange-950/30"
                      : "border-white/10 bg-zinc-950/60 text-zinc-400 hover:border-white/20 hover:text-white"
                  }`}
                >
                  <div className="flex w-full items-center justify-between">
                    <Store
                      className={`size-5 ${
                        formData.role === "vendor"
                          ? "text-orange-500"
                          : "text-zinc-500"
                      }`}
                    />
                    {formData.role === "vendor" && (
                      <span className="size-2 rounded-full bg-orange-500" />
                    )}
                  </div>
                  <span className="font-semibold text-sm mt-1">
                    Restaurant Owner
                  </span>
                  <span className="text-[11px] text-zinc-400 leading-tight">
                    Manage menu &amp; accept orders
                  </span>
                </button>
              </div>
            </div>

            {/* Profile Image Upload */}
            <div>
              <label className="block text-xs font-semibold uppercase tracking-wider text-zinc-300 mb-1.5">
                Profile Image (Optional)
              </label>
              <div className="flex items-center gap-4">
                {imagePreview ? (
                  <div className="relative size-16 shrink-0 rounded-full border border-orange-500/50 overflow-hidden bg-zinc-800">
                    <Image
                      src={imagePreview}
                      alt="Profile preview"
                      fill
                      unoptimized
                      className="object-cover"
                    />
                    <button
                      type="button"
                      onClick={handleRemoveImage}
                      className="absolute inset-0 flex items-center justify-center bg-black/60 opacity-0 hover:opacity-100 transition-opacity text-white"
                      title="Remove image"
                    >
                      <X className="size-5" />
                    </button>
                  </div>
                ) : (
                  <div className="flex size-16 shrink-0 items-center justify-center rounded-full border border-dashed border-white/20 bg-zinc-950/70 text-zinc-500">
                    <User className="size-7" />
                  </div>
                )}

                <label
                  htmlFor={fileInputId}
                  className="flex flex-1 cursor-pointer items-center justify-center gap-2 rounded-xl border border-white/10 bg-zinc-950/60 px-4 py-2.5 text-xs font-medium text-zinc-300 transition-colors hover:bg-zinc-800 hover:text-white"
                >
                  <Upload className="size-4 text-zinc-400" />
                  <span>{imagePreview ? "Change Photo" : "Upload Photo"}</span>
                  <input
                    id={fileInputId}
                    type="file"
                    accept="image/*"
                    onChange={handleImageChange}
                    className="hidden"
                  />
                </label>
              </div>
            </div>

            {/* Full Name */}
            <div>
              <label
                htmlFor="name"
                className="block text-xs font-semibold uppercase tracking-wider text-zinc-300 mb-1.5"
              >
                Full Name
              </label>
              <div className="relative">
                <User className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 size-4 text-zinc-500" />
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  placeholder="John Doe"
                  value={formData.name}
                  onChange={handleChange}
                  className="w-full rounded-xl border border-white/10 bg-zinc-950/70 pl-10 pr-4 py-2.5 text-sm text-white placeholder-zinc-500 outline-none transition-colors focus:border-orange-500 focus:ring-1 focus:ring-orange-500"
                />
              </div>
            </div>

            {/* Email Address */}
            <div>
              <label
                htmlFor="email"
                className="block text-xs font-semibold uppercase tracking-wider text-zinc-300 mb-1.5"
              >
                Email Address
              </label>
              <div className="relative">
                <Mail className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 size-4 text-zinc-500" />
                <input
                  id="email"
                  name="email"
                  type="email"
                  autoComplete="email"
                  required
                  placeholder="name@example.com"
                  value={formData.email}
                  onChange={handleChange}
                  className="w-full rounded-xl border border-white/10 bg-zinc-950/70 pl-10 pr-4 py-2.5 text-sm text-white placeholder-zinc-500 outline-none transition-colors focus:border-orange-500 focus:ring-1 focus:ring-orange-500"
                />
              </div>
            </div>

            {/* Password Field */}
            <div>
              <label
                htmlFor="password"
                className="block text-xs font-semibold uppercase tracking-wider text-zinc-300 mb-1.5"
              >
                Password
              </label>
              <div className="relative">
                <Lock className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 size-4 text-zinc-500" />
                <input
                  id="password"
                  name="password"
                  type={showPassword ? "text" : "password"}
                  autoComplete="new-password"
                  required
                  placeholder="Create a strong password"
                  value={formData.password}
                  onChange={handleChange}
                  className="w-full rounded-xl border border-white/10 bg-zinc-950/70 pl-10 pr-10 py-2.5 text-sm text-white placeholder-zinc-500 outline-none transition-colors focus:border-orange-500 focus:ring-1 focus:ring-orange-500"
                />
                <button
                  type="button"
                  onClick={() => setShowPassword(!showPassword)}
                  className="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-zinc-500 hover:text-zinc-300 transition-colors"
                >
                  {showPassword ? (
                    <EyeOff className="size-4" />
                  ) : (
                    <Eye className="size-4" />
                  )}
                </button>
              </div>

              {/* Password Rule Validation Indicators */}
              <div className="mt-2.5 space-y-1.5 rounded-xl bg-zinc-950/50 p-2.5 border border-white/5 text-xs">
                <p className="font-medium text-zinc-400 text-[11px] mb-1">
                  Password Requirements:
                </p>
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-1.5">
                  <div
                    className={`flex items-center gap-1.5 transition-colors ${
                      passwordRules.hasMinLength
                        ? "text-emerald-400"
                        : "text-zinc-500"
                    }`}
                  >
                    <Check
                      className={`size-3.5 ${
                        passwordRules.hasMinLength
                          ? "stroke-[3]"
                          : "opacity-40"
                      }`}
                    />
                    <span>Min 6 chars</span>
                  </div>
                  <div
                    className={`flex items-center gap-1.5 transition-colors ${
                      passwordRules.hasUppercase
                        ? "text-emerald-400"
                        : "text-zinc-500"
                    }`}
                  >
                    <Check
                      className={`size-3.5 ${
                        passwordRules.hasUppercase
                          ? "stroke-[3]"
                          : "opacity-40"
                      }`}
                    />
                    <span>1 Uppercase</span>
                  </div>
                  <div
                    className={`flex items-center gap-1.5 transition-colors ${
                      passwordRules.hasLowercase
                        ? "text-emerald-400"
                        : "text-zinc-500"
                    }`}
                  >
                    <Check
                      className={`size-3.5 ${
                        passwordRules.hasLowercase
                          ? "stroke-[3]"
                          : "opacity-40"
                      }`}
                    />
                    <span>1 Lowercase</span>
                  </div>
                </div>
              </div>
            </div>

            {/* Submit Button */}
            <button
              type="submit"
              disabled={isSubmitting}
              className="mt-2 flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-red-600 to-orange-500 py-3 text-sm font-semibold text-white shadow-lg shadow-red-950/40 transition-all hover:opacity-95 hover:shadow-orange-950/50 disabled:opacity-50"
            >
              {isSubmitting ? (
                <span>Creating Account...</span>
              ) : (
                <>
                  <span>Create Account</span>
                  <ArrowRight className="size-4" />
                </>
              )}
            </button>
          </form>

          {/* Toggle Link at Bottom */}
          <div className="mt-6 text-center text-sm text-zinc-400">
            Already have an account?{" "}
            <Link
              href="/sign-in"
              className="font-semibold text-orange-500 hover:text-orange-400 transition-colors"
            >
              Sign In
            </Link>
          </div>
        </div>
      </div>
    </div>
  );
}

